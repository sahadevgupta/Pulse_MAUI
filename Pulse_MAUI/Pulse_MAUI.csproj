<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Pulse_MAUI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Pulse MAUI</ApplicationTitle>

		<!-- App Identifier -->
		<!-- <ApplicationId>com.companyname.pulse_maui</ApplicationId> -->
		<ApplicationId>com.Pulse.Pulse_MAUI</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\applogo.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\appsplash.png" Color="#ffffff" Resize="True" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Data\DataManagerItems.cs" />
	  <Compile Remove="Repository\AppDataRepository+ActivityTask.cs" />
	  <Compile Remove="Repository\AppDataRepository.cs" />
	  <Compile Remove="Repository\IAppDataRepository.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="14.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="FFImageLoading.Maui" Version="1.3.2" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.79.1" />
		<!-- <PackageReference Include="Microsoft.Datasync.Client" Version="6.1.0" />
		<PackageReference Include="Microsoft.Datasync.Client.SQLiteStore" Version="6.1.0" /> -->
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
		<PackageReference Include="Mopups" Version="1.3.4" />
		<PackageReference Include="Refit.HttpClientFactory" Version="9.0.2" />
		<PackageReference Include="Refit.Newtonsoft.Json" Version="9.0.2" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
		<PackageReference Include="WindowsAzure.Storage" Version="9.3.3" />
		<PackageReference Include="Sentry.Maui" Version="5.16.2" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Languages\AppParameters.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppParameters.resx</DependentUpon>
		</Compile>
		<Compile Update="Resources\Languages\UserInterface.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>UserInterface.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets/appsettings.DEV.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Assets/appsettings.PROD.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
		<EmbeddedResource Include="Assets/appsettings.TST.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="../azure-mobile-apps-main/sdk/dotnet/src/Microsoft.Datasync.Client.SQLiteStore/Microsoft.Datasync.Client.SQLiteStore.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
		<!-- Point to Entitlements.plist for keychain access -->
		<CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>

		<!-- Manual provisioning and code signing -->
		<ProvisioningType>manual</ProvisioningType>
		<CodesignKey>Apple Development: Marcus Moloney (QZ8W2AE38S)</CodesignKey>
        <CodesignProvision>Seafarer Development</CodesignProvision>
		<EnableCodeSigning>true</EnableCodeSigning>
		<CodesignRequireProvisioningProfile>true</CodesignRequireProvisioningProfile>

		<!-- Debugging -->
		<MtouchDebug>true</MtouchDebug>
		<ApplicationTitle>SEA 360 DEV</ApplicationTitle> 
		<ApplicationId>com.liscr.Seafarer.DEV</ApplicationId>
    </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		

		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>Platforms/Android/KeyStore/Pulse.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>Pulse</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>1234567890</AndroidSigningKeyPass>
		<AndroidSigningStorePass>1234567890</AndroidSigningStorePass>

		<!-- Reduce size -->
		<AndroidPackageFormat>aab</AndroidPackageFormat>

		<!-- Reduce .NET runtime size -->
		<MauiEnableILLink>true</MauiEnableILLink>
		<PublishTrimmed>true</PublishTrimmed>

		<!-- Remove debugging -->
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>

		<!-- Disable AOT to save 20–30MB -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidUseAapt2>true</AndroidUseAapt2>
			
		<!-- <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<MauiEnableTracing>false</MauiEnableTracing>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<AndroidStripNativeDebugSymbols>true</AndroidStripNativeDebugSymbols>
		

		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidUseAapt2>true</AndroidUseAapt2> -->

		<!-- <EmbedAssembliesIntoApk>false</EmbedAssembliesIntoApk> -->

		<!-- SAFE TRIMMING -->
		<!-- <PublishTrimmed>true</PublishTrimmed>
		<TrimMode>link</TrimMode> -->

		<!-- <InvariantGlobalization>false</InvariantGlobalization>  -->
		<!-- Required for many cultures -->

		<!-- LINKING -->
		<!-- <AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<AndroidLinkTool>r8</AndroidLinkTool>

		<RunAOTCompilation>false</RunAOTCompilation> -->

	</PropertyGroup>

</Project>
