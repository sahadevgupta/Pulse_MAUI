        <StackLayout x:Name="FixedFooterContainer"
                     Grid.Row="2"
                     Padding="20,12,20,20"
                     Spacing="10">
            <Label Text="{Binding LastSyncText}"
                   Style="{StaticResource LabelDefaultSignikaMedium}"
                   FontSize="14"
                   TextColor="#CEE1EA"
                   Margin="0,0,5,4"/>
            <Button Text="Synchronise"
                    Command="{Binding SynchroniseDataUnifiedCommand}"
                    IsEnabled="{Binding IsAuthenticated}"
                    Style="{StaticResource FlyoutLightButton}">
                <Button.Triggers>
                    <Trigger TargetType="Button"
                             Property="IsEnabled"
                             Value="False">
                        <Setter Property="TextColor"
                                Value="{StaticResource LightGray}"/>
                        <Setter Property="BackgroundColor"
                                Value="{StaticResource ChalkGrey}"/>
                        <Setter Property="Opacity"
                                Value="0.6"/>
                    </Trigger>
                    <Trigger TargetType="Button"
                             Property="IsEnabled"
                             Value="True">
                        <Setter Property="TextColor"
                                Value="{StaticResource DarkBlue}"/>
                        <Setter Property="BackgroundColor"
                                Value="#FFFFFF"/>
                        <Setter Property="Opacity"
                                Value="1"/>
                    </Trigger>
                </Button.Triggers>
            </Button>
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    ImageSource="logout_icon.svg"
                    IsEnabled="{Binding IsAuthenticated}"
                    Style="{StaticResource FlyoutAccentButton}">
                <Button.Triggers>
                    <Trigger TargetType="Button"
                             Property="IsEnabled"
                             Value="False">
                        <Setter Property="TextColor"
                                Value="{StaticResource LightGray}"/>
                        <Setter Property="Opacity"
                                Value="0.45"/>
                    </Trigger>
                    <Trigger TargetType="Button"
                             Property="IsEnabled"
                             Value="True">
                        <Setter Property="TextColor"
                                Value="{StaticResource White}"/>
                        <Setter Property="Opacity"
                                Value="1"/>
                    </Trigger>
                </Button.Triggers>
            </Button>
            <Label Text="© 2026 Engineurs Pulse"
                   FontFamily="SignikaRehular"
                   FontSize="10"
                   TextColor="#CEE1EA"/>
            <Label Text="{Binding BuildNumberText}"
                   FontFamily="SignikaRehular"
                   FontSize="10"
                   TextColor="#CEE1EA"
                   Margin="0,-6,0,0"/>
        </StackLayout>


    </Grid>
</ContentView>