        <Grid x:Name="FixedHeaderContainer"
              Grid.Row="0"
              BackgroundColor="#04273F"
              Padding="16,16,20,10"
              RowDefinitions="Auto,*,Auto">
            <Image Grid.Row="0"
                   Source="pulse_logo_horizontal_white.png"
                   HeightRequest="72"
                   HorizontalOptions="Start"
                   Margin="0,12,0,0"
                   Aspect="AspectFit">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenPulseWebsiteCommand}"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Row="1"
                   Text="Completions made precise."
                   FontFamily="sans-serif"
                   FontSize="16"
                   TextColor="#CEE1EA"
                   Margin="2,14,0,0"/>
            <Label Grid.Row="2"
                   Text="{Binding ProfileName}"
                   FontFamily="sans-serif-medium"
                   FontSize="18"
                   TextColor="White"
                   Margin="2,12,0,0"/>
        </Grid>


        <CollectionView Grid.Row="1"
                        Margin="0,10,0,0"
                        x:Name="menus"
                        ItemsSource="{Binding OptionsItems}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="8"
                                   Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MenuOption">
                    <Border BackgroundColor="#0B3A59"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Margin="12,0"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.MenuSelectedCommand,Source={x:Reference menus}}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Image Source="{Binding IconSource}"
                                   HeightRequest="24"
                                   WidthRequest="24"
                                   VerticalOptions="Center"
                                   Aspect="AspectFit"/>
                            <Label Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontFamily="sans-serif-medium"
                                   FontSize="20"
                                   TextColor="White"
                                   VerticalTextAlignment="Center"/>
                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

