<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pulse_MAUI.Controls.CustomPicker"
             x:Name="customPicker">
    <VerticalStackLayout>
        <Label Style="{StaticResource LabelDefaultSignikaRegular}"
               FontSize="16"
               Text="{Binding Title,Source={x:Reference customPicker}}"
               TextColor="White"/>

        <Picker ItemsSource="{Binding ItemsSource,Source={x:Reference customPicker}}"
                SelectedItem="{Binding SelectedItem,Source={x:Reference customPicker}}"
                TextColor="{StaticResource OffBlack}"
                FontSize="16"
                Title="{Binding Title,Source={x:Reference customPicker},StringFormat='Select {0}'}"
                FontFamily="SignikaRegular"
                x:Name="MainPicker"/>

    </VerticalStackLayout>
</ContentView>
