<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#6A4BC3</Color>
    <Color x:Key="PrimaryBlue">#2276D7</Color>
    <Color x:Key="PrimaryTeal">#1FA2A6</Color>
    <Color x:Key="PrimaryGreen">#4CAF50</Color>
    <Color x:Key="NeutralGray">#8C8C8C</Color>
    <Color x:Key="LightBackground">#F6F9FC</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="ChalkGrey">#cee1ea</Color>
    <Color x:Key="Green">#008000</Color>

    <!-- GRADIENT -->
    <LinearGradientBrush x:Key="BrandGradient"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="{StaticResource Primary}"
                      Offset="0.0"/>
        <GradientStop Color="{StaticResource PrimaryBlue}"
                      Offset="0.3"/>
        <GradientStop Color="{StaticResource PrimaryTeal}"
                      Offset="0.6"/>
        <GradientStop Color="{StaticResource PrimaryGreen}"
                      Offset="1.0"/>
    </LinearGradientBrush>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>
    <Color x:Key="DarkBlue">#04273F</Color>
    <Color x:Key="StockLightBlue">#27aaE1</Color>
    <Color x:Key="PopupBackground">#A0000000</Color>


</ResourceDictionary>