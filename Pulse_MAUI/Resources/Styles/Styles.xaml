<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
        xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:helpers="clr-namespace:Pulse_MAUI.Helpers">

        <!-- Shell navigation bar -->
        <Style TargetType="Shell"
               ApplyToDerivedTypes="True">
                <Setter Property="Shell.BackgroundColor"
                        Value="{StaticResource DarkBlue}"/>
                <Setter Property="Shell.ForegroundColor"
                        Value="{StaticResource White}"/>
                <Setter Property="Shell.TitleColor"
                        Value="{StaticResource White}"/>
                <Setter Property="Shell.DisabledColor"
                        Value="{StaticResource ChalkGrey}"/>
                <Setter Property="Shell.UnselectedColor"
                        Value="{StaticResource ChalkGrey}"/>
                <Setter Property="Shell.FlyoutBackgroundColor"
                        Value="{StaticResource DarkBlue}"/>
                <Setter Property="Shell.FlyoutBehavior"
                        Value="Flyout"/>
        </Style>

        <Style x:Key="SectionTitleLabel"
               TargetType="Label">
                <Setter Property="FontFamily"
                        Value="SignikaMedium"/>
                <Setter Property="TextColor"
                        Value="{StaticResource DarkBlue}"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Medium}"/>
                <Setter Property="Margin"
                        Value="0,4,0,1"/>
        </Style>

        <Style x:Key="CardFrame"
               TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource White}"/>
                <Setter Property="Stroke"
                        Value="{StaticResource BorderGray}"/>
                <Setter Property="StrokeThickness"
                        Value="1"/>
                <Setter Property="Padding"
                        Value="10"/>
                <Setter Property="Margin"
                        Value="0,0,0,6"/>
                <Setter Property="StrokeShape">
                        <Setter.Value>
                                <RoundRectangle CornerRadius="8"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style TargetType="ContentPage"
               ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource PageBackground}"/>
        </Style>

        <Style TargetType="Label"
               x:Key="LabelDefaultSignikaRegular">
                <Setter Property="FontFamily"
                        Value="SignikaRegular"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Default}"/>
                <Setter Property="VerticalOptions"
                        Value="Center"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Medium}"/>
        </Style>

        <Style TargetType="Label"
               x:Key="LabelDefaultSignikaMedium">
                <Setter Property="FontFamily"
                        Value="SignikaMedium"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Default}"/>
                <Setter Property="VerticalOptions"
                        Value="Center"/>
        </Style>

        <Style TargetType="Label"
               x:Key="LabelDefaultSignikaBold">
                <Setter Property="FontFamily"
                        Value="SignikaBold"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Default}"/>
                <Setter Property="VerticalOptions"
                        Value="Center"/>
        </Style>

        <Style TargetType="Label"
               x:Key="LabelLargeSignikaRegularStockLightBlueStyle"
               BasedOn="{StaticResource LabelDefaultSignikaRegular}">
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Large}"/>
                <Setter Property="TextColor"
                        Value="{x:Static helpers:Colors.StockLightBlue}"/>
        </Style>

        <Shadow Brush="LightGray"
                Offset="5,5"
                Opacity="0.4"
                x:Key="DefaultShadow"/>

        <Style TargetType="Border"
               x:Key="DefaultBorderStyle">
                <Setter Property="StrokeShape"
                        Value="RoundRectangle 8"/>
                <Setter Property="StrokeThickness"
                        Value="0"/>
                <Setter Property="Shadow"
                        Value="{StaticResource DefaultShadow}"/>
        </Style>

        <Style TargetType="Button"
               x:Key="DefaultButtonStyle">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource DarkBlue}"/>
                <Setter Property="TextColor"
                        Value="White"/>
                <Setter Property="CornerRadius"
                        Value="12"/>
                <Setter Property="FontFamily"
                        Value="SignikaMedium"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Medium}"/>
                <Setter Property="TextTransform"
                        Value="Uppercase"/>
                <Setter Property="BorderWidth"
                        Value="0"/>
                <Setter Property="CornerRadius"
                        Value="4"/>
                <Setter Property="Padding"
                        Value="20,10"/>
                <Setter Property="MinimumHeightRequest"
                        Value="44"/>
                <Setter Property="MinimumWidthRequest"
                        Value="44"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                        <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                        <Setter Property="TextColor"
                                                                Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}"/>
                                                        <Setter Property="BackgroundColor"
                                                                Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"/>
                                                </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver"/>
                                </VisualStateGroup>
                        </VisualStateGroupList>
                </Setter>

        </Style>

        <Style x:Key="AccentButton"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource BrightBlue}"/>
        </Style>

        <Style x:Key="InputFieldBorder"
               TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource White}"/>
                <Setter Property="Stroke"
                        Value="{StaticResource BorderGray}"/>
                <Setter Property="StrokeThickness"
                        Value="1"/>
                <Setter Property="Padding"
                        Value="8,1"/>
                <Setter Property="StrokeShape">
                        <Setter.Value>
                                <RoundRectangle CornerRadius="6"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="FlyoutLightButton"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BackgroundColor"
                        Value="#FFFFFF"/>
                <Setter Property="TextColor"
                        Value="#04273F"/>
        </Style>

        <Style x:Key="FlyoutAccentButton"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BackgroundColor"
                        Value="{StaticResource Purple}"/>
                <Setter Property="TextColor"
                        Value="{StaticResource White}"/>
        </Style>

        <Style x:Key="SectionBannerLabel"
               TargetType="Label">
                <Setter Property="FontFamily"
                        Value="SignikaBold"/>
                <Setter Property="TextColor"
                        Value="{StaticResource White}"/>
                <Setter Property="FontSize"
                        Value="{x:Static helpers:FontSizes.Medium}"/>
                <Setter Property="VerticalTextAlignment"
                        Value="Center"/>
        </Style>

